<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="pika op" Width="1180" Height="820" MinWidth="960" MinHeight="640" Background="#091018" Foreground="#E6EDF5" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#54E3B0"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#12202E"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E6EDF5"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E6EDF5"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#8193A7"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#111C28"/><Setter Property="BorderBrush" Value="#203040"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#1C3040"/><Setter Property="Foreground" Value="#E6EDF5"/><Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="0,4,10,4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D9E5EF"/><Setter Property="Margin" Value="0,9"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Track" Height="22" Width="38" CornerRadius="11" Background="#344454" HorizontalAlignment="Left"><Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#D6E0E8" HorizontalAlignment="Left" Margin="3,0"/></Border><ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0" RecognizesAccessKey="True"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#1B7459"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Fill" Value="#65E9BD"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#C9FFF0"/><Setter TargetName="Track" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0B1520"/><Setter Property="Foreground" Value="#E6EDF5"/><Setter Property="CaretBrush" Value="#54E3B0"/><Setter Property="BorderBrush" Value="#2A3E50"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,6,0,12"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#0B1520"/><Setter Property="Foreground" Value="#E6EDF5"/><Setter Property="BorderBrush" Value="#2A3E50"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,6,0,12"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#E6EDF5"/><Setter Property="Height" Value="42"/><Setter Property="Margin" Value="0,6,0,16"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#0B1520" BorderBrush="#2A3E50" BorderThickness="1" CornerRadius="7"><TextBlock Text="⌄" Foreground="#54E3B0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,4" FontSize="18"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="14,0,38,0" VerticalAlignment="Center" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#12202E" BorderBrush="#2A3E50" BorderThickness="1" CornerRadius="7" MinWidth="{TemplateBinding ActualWidth}" Padding="4"><ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#12202E"/><Setter Property="Foreground" Value="#E6EDF5"/></Style>
  <Style TargetType="Slider"><Setter Property="Margin" Value="0,10,0,22"/><Setter Property="Height" Value="20"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate><Border Height="4" Background="#38AE88" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="16" Height="16"><Thumb.Template><ControlTemplate><Ellipse Fill="#6BECC0" Stroke="#173F32" StrokeThickness="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate><Border Height="4" Background="#2A3C4B" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate><Border Background="#304757" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Margin" Value="8,3"/><Setter Property="Padding" Value="18,12"/><Setter Property="Foreground" Value="#91A5B7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#17382F"/><Setter Property="Foreground" Value="#6EF0C1"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#0C1621"/><Setter Property="Foreground" Value="#D9E5EF"/><Setter Property="RowBackground" Value="#0F1B28"/><Setter Property="AlternatingRowBackground" Value="#12202E"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeight" Value="36"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1B2B3A"/><Setter Property="Foreground" Value="#95ACBF"/><Setter Property="Padding" Value="12"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,6"/><Setter Property="BorderThickness" Value="0"/></Style>
 </Window.Resources>
 <Grid Background="#091018"><Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#0B141E" BorderBrush="#1C2A37" BorderThickness="0,0,1,0"><DockPanel Margin="10,28,10,18">
   <StackPanel DockPanel.Dock="Top" Margin="18,0,0,24"><TextBlock Text="pika op" FontSize="29" FontWeight="Bold" Foreground="#65E9BD"/><TextBlock Text="STANDALONE / 1.5" Foreground="#657E92" FontSize="10" Margin="2,8,0,0"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="18,12"><TextBlock x:Name="ConnectionBadge" Text="WAITING FOR SESSION" Foreground="#7AA18F" FontSize="10"/><TextBlock Text="F6  Pause session&#10;F8  Disable tracking" Foreground="#61798B" FontSize="11" LineHeight="23" Margin="0,16,0,0"/></StackPanel>
   <ListBox x:Name="Navigation" Background="Transparent" BorderThickness="0" SelectedIndex="0"><ListBoxItem Content="Overview"/><ListBoxItem Content="Visuals"/><ListBoxItem Content="Tracking"/><ListBoxItem Content="Players"/><ListBoxItem Content="Enemy review"/><ListBoxItem Content="Recording"/><ListBoxItem Content="Practice"/><ListBoxItem Content="Diagnostics"/><ListBoxItem Content="Security"/></ListBox>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="30,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Overview" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="External telemetry, designed for your local research session" Foreground="#7890A4" Margin="0,7,0,0"/></StackPanel><Border Grid.Column="1" Background="#14372C" CornerRadius="15" Padding="14,7" VerticalAlignment="Top"><TextBlock Text="PIKA OP / 1.5" Foreground="#76E6BA" FontSize="10"/></Border></Grid>
   <Grid x:Name="Pages" Grid.Row="1">
    <ScrollViewer x:Name="Overview" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
     <UniformGrid Columns="3" Margin="0,0,-12,0"><Border Style="{StaticResource Card}" Margin="0,0,12,16"><StackPanel><TextBlock Text="PLAYERS" Foreground="#718B9F" FontSize="10"/><TextBlock x:Name="PlayersMetric" Text="—" FontSize="35" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,16"><StackPanel><TextBlock Text="MEMORY READ" Foreground="#718B9F" FontSize="10"/><TextBlock x:Name="ReadMetric" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,14,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,16"><StackPanel><TextBlock Text="ACTIVE WEAPON" Foreground="#718B9F" FontSize="10"/><TextBlock x:Name="WeaponMetric" Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,18,0,0"/></StackPanel></Border></UniformGrid>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Position radar" Style="{StaticResource Heading}"/><TextBlock Text="World XY positions relative to you. No map or visibility information." Style="{StaticResource Muted}"/><Canvas x:Name="Radar" Height="260" Background="#0B1520" Margin="0,18,0,12"/><TextBlock Text="Radar range"/><Slider Minimum="500" Maximum="6000" Value="{Binding RadarRange}"/><CheckBox Content="Pause session" IsChecked="{Binding Paused}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Session health" Style="{StaticResource Heading}"/><TextBlock x:Name="OverviewSummary" Text="Open a local map to start sampling." Style="{StaticResource Muted}"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="Visuals" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Player overlay" Style="{StaticResource Heading}"/><CheckBox Content="Player boxes and health" IsChecked="{Binding Esp}"/><CheckBox Content="Adaptive distance detail / hide overlapping labels" IsChecked="{Binding AdaptiveEsp}"/><TextBlock Text="Small targets use thin boxes and shorter labels. Tiny targets show boxes only. Overlapping labels give priority to the selected target, then nearer players." Style="{StaticResource Muted}"/><CheckBox Content="Show teammates" IsChecked="{Binding Teammates}"/><CheckBox Content="Player names" IsChecked="{Binding Names}"/><CheckBox Content="Weapons and ammo" IsChecked="{Binding Weapons}"/><CheckBox Content="Scoped / defusing / immunity flags" IsChecked="{Binding ShowStatus}"/><CheckBox Content="Health-based bar colours" IsChecked="{Binding HealthColors}"/><CheckBox Content="Spotted-state box colours (visibility proxy)" IsChecked="{Binding SpottedColors}"/><CheckBox Content="Head marker (approximate without verified bones)" IsChecked="{Binding HeadMarker}"/><CheckBox Content="Armor bars" IsChecked="{Binding Armor}"/><CheckBox Content="Distance labels" IsChecked="{Binding Distances}"/><CheckBox Content="Corner boxes" IsChecked="{Binding Corners}"/><CheckBox Content="Snaplines" IsChecked="{Binding Snaplines}"/><CheckBox Content="Center crosshair" IsChecked="{Binding Crosshair}"/><CheckBox Content="Skeleton (verified profile required)" IsChecked="{Binding Skeleton}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Appearance" Style="{StaticResource Heading}"/><TextBlock Text="Accent palette"/><ComboBox SelectedValue="{Binding Palette}" SelectedValuePath="Content"><ComboBoxItem Content="Emerald"/><ComboBoxItem Content="Blue"/><ComboBoxItem Content="Rose"/><ComboBoxItem Content="Amber"/></ComboBox><TextBlock Text="Maximum distance (0 = unlimited)"/><Slider Minimum="0" Maximum="10000" Value="{Binding MaxDistance}"/><TextBlock Text="Overlay opacity"/><Slider Minimum="0.45" Maximum="1" Value="{Binding Opacity}"/><TextBlock Text="Label size"/><Slider Minimum="8" Maximum="18" Value="{Binding FontSize}"/><TextBlock Text="Line width"/><Slider Minimum="1" Maximum="4" Value="{Binding Stroke}"/><TextBlock Text="Fallback height"/><Slider Minimum="40" Maximum="80" Value="{Binding Height}"/></StackPanel></Border></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="Tracking" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
     <Border Style="{StaticResource Card}" Background="#12382F"><StackPanel><TextBlock Text="Tracking workspace" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Choose a weapon profile, tune response, then save. F8 stops tracking immediately." Style="{StaticResource Muted}" Margin="0,8,0,0"/><CheckBox Content="Enable tracking — hold selected key" IsChecked="{Binding Aim}"/></StackPanel></Border>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="01 / Activation" Style="{StaticResource Heading}"/><TextBlock Text="Hold key"/><ComboBox SelectedValue="{Binding ActivationKey}" SelectedValuePath="Content"><ComboBoxItem Content="Left mouse"/><ComboBoxItem Content="Right mouse"/><ComboBoxItem Content="Mouse 4"/><ComboBoxItem Content="Mouse 5"/><ComboBoxItem Content="Alt"/></ComboBox><CheckBox Content="Alt shortcut for pre-alignment" IsChecked="{Binding Preaim}"/><CheckBox Content="Track only while scoped" IsChecked="{Binding ScopedOnly}"/><CheckBox Content="Allow teammate targets" IsChecked="{Binding AimTeammates}"/><CheckBox Content="Show aim radius" IsChecked="{Binding ShowRadius}"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="02 / Target selection" Style="{StaticResource Heading}"/><CheckBox Content="Require local spotted state" IsChecked="{Binding SpottedOnly}"/><TextBlock Text="Visibility proxy only. Spotted state can lag and does not trace walls, smoke, or the selected joint. Unknown state blocks tracking when enabled." Style="{StaticResource Muted}"/><CheckBox Content="Keep target while eligible" IsChecked="{Binding LockTarget}"/><TextBlock Text="Priority"/><ComboBox SelectedValue="{Binding Priority}" SelectedValuePath="Content"><ComboBoxItem Content="Crosshair"/><ComboBoxItem Content="Distance"/><ComboBoxItem Content="Lowest health"/></ComboBox><TextBlock Text="Aim point"/><ComboBox SelectedValue="{Binding AimPoint}" SelectedValuePath="Content"><ComboBoxItem Content="Chest"/><ComboBoxItem Content="Head"/></ComboBox></StackPanel></Border></StackPanel>
      <StackPanel Grid.Column="2"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="03 / Weapon profile" Style="{StaticResource Heading}"/><CheckBox Content="Auto-select from active weapon" IsChecked="{Binding AutoPreset}"/><ComboBox x:Name="PresetPicker" SelectedValue="{Binding Preset}" SelectedValuePath="Content"><ComboBoxItem Content="Rifle"/><ComboBoxItem Content="Sniper"/><ComboBoxItem Content="Desert Eagle / Tap"/><ComboBoxItem Content="Pistol"/><ComboBoxItem Content="SMG"/><ComboBoxItem Content="Shotgun"/><ComboBoxItem Content="Aggressive"/></ComboBox><Button x:Name="SaveProfile" Content="Save weapon profile" Background="#1C634D"/><Button x:Name="ResetProfile" Content="Load factory values"/><TextBlock Text="Aggressive: head target, 40 ms smoothing, 3200 counts/s. Selecting it enables the spotted filter and disables automatic weapon switching. It never enables tracking by itself." Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="04 / Response" Style="{StaticResource Heading}"/><TextBlock Text="{Binding Radius,StringFormat='Aim radius: {0:F0} px'}"/><Slider Minimum="30" Maximum="500" Value="{Binding Radius}"/><TextBlock Text="{Binding Tau,StringFormat='Smoothing: {0:F3} s'}"/><Slider Minimum="0.04" Maximum="0.6" Value="{Binding Tau}"/><TextBlock Text="{Binding Deadzone,StringFormat='Deadzone: {0:F1} px'}"/><Slider Minimum="0" Maximum="10" Value="{Binding Deadzone}"/><TextBlock Text="{Binding MaxSpeed,StringFormat='Speed: {0:F0} counts/s'}"/><Slider Minimum="100" Maximum="6000" Value="{Binding MaxSpeed}"/><TextBlock Text="{Binding Gain,StringFormat='Calibration: {0:F2}'}"/><Slider Minimum="0.25" Maximum="2" Value="{Binding Gain}"/></StackPanel></Border></StackPanel>
     </Grid><TextBlock Text="Tracking starts disabled. Head/chest are approximate without verified bones. No recoil or spread compensation." Style="{StaticResource Muted}"/>
    </StackPanel></ScrollViewer>
    <Grid x:Name="Players" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="Search" ToolTip="Search player or weapon"/><DataGrid x:Name="PlayerTable" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="HP" Binding="{Binding Health}"/><DataGridTextColumn Header="Armor" Binding="{Binding Armor}"/><DataGridTextColumn Header="Weapon" Binding="{Binding Weapon}" Width="100"/><DataGridTextColumn Header="Ammo" Binding="{Binding Ammo}"/><DataGridTextColumn Header="Range (u)" Binding="{Binding Distance,StringFormat=F0}"/><DataGridCheckBoxColumn Header="Scoped" Binding="{Binding Scoped}"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="2" Margin="0,14,0,0"><Button x:Name="SnapshotButton" Content="Export JSON snapshot"/><Button x:Name="CsvButton" Content="Export player CSV"/></WrapPanel></Grid>
    <Grid x:Name="Review" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Enemy review / experimental" Style="{StaticResource Heading}"/><TextBlock Text="These observations cannot identify confirmed cheaters. Fast flicks, network batching, interpolation, and stale offsets can trigger review flags. No flag means no conclusion, not a clean verdict." Style="{StaticResource Muted}"/><CheckBox Content="Show review indicators on overlay" IsChecked="{Binding ReviewIndicators}"/><TextBlock Text="Rule: at least 3 observed turns of 45° or more, at 1800°/s or more, in 5 seconds. Only changed angles with 5–50 ms intervals count; gaps and large position jumps reset history." Style="{StaticResource Muted}"/><TextBlock x:Name="ReviewSummary" Text="Waiting for enemy angle samples." Foreground="#FBBF24" Margin="0,12,0,0"/></StackPanel></Border><DataGrid x:Name="ReviewTable" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Enemy" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Observation" Binding="{Binding Review}" Width="230"/><DataGridTextColumn Header="Turns / 5 s" Binding="{Binding RapidTurns}" Width="100"/><DataGridTextColumn Header="Local spotted" Binding="{Binding SpottedLabel}" Width="120"/></DataGrid.Columns></DataGrid></Grid>
    <ScrollViewer x:Name="Recording" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Capture an experiment" Style="{StaticResource Heading}"/><TextBlock Text="Record raw frames as JSON Lines at up to 10 Hz. Display filters do not change recorded data. Pausing creates a gap; disconnecting stops recording." Style="{StaticResource Muted}"/><TextBlock x:Name="RecordingState" Text="Not recording" Foreground="#65E9BD" FontSize="18" Margin="0,24"/><WrapPanel><Button x:Name="StartRecording" Content="Start recording" Background="#1C634D"/><Button x:Name="StopRecording" Content="Stop recording"/></WrapPanel></StackPanel></Border></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="Practice" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Local practice controls" Style="{StaticResource Heading}"/><TextBlock Text="Copy commands, then paste them into CS2's developer console. Copying does not change the game." Style="{StaticResource Muted}"/><Button x:Name="CopySpread" Content="Copy local no-spread command" HorizontalAlignment="Left" Margin="0,20,0,14"/><TextBlock Text="No recoil is unavailable. Your build rejected the two previously suggested recoil commands. Magic bullet and hit-registration changes are not implemented." Style="{StaticResource Muted}"/></StackPanel></Border></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="Diagnostics" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Telemetry source" Style="{StaticResource Heading}"/><TextBox Text="{Binding SourceFolder,UpdateSourceTrigger=PropertyChanged}"/><WrapPanel><Button x:Name="BrowseDump" Content="Choose dump folder"/><Button x:Name="UseBundledDump" Content="Use bundled dump"/><Button x:Name="Reconnect" Content="Reconnect"/><Button x:Name="SaveSettings" Content="Save settings"/><Button x:Name="InventoryButton" Content="Export dump inventory"/></WrapPanel><TextBlock x:Name="DiagnosticsText" Style="{StaticResource Muted}" Margin="0,18"/><TextBox x:Name="EventLog" IsReadOnly="True" Height="170" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel></Border></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="Security" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Release integrity" Style="{StaticResource Heading}"/><TextBlock x:Name="IntegrityState" Text="Signed release verification passed" Foreground="#65E9BD"/><TextBlock x:Name="LicenseStatus" Foreground="#9CB2C3" TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock Text="The executable is checked against its embedded RSA-signed release data at startup and periodically while running. This detects changed release files; it cannot guarantee an uncrackable app or detect offline decompilation." Style="{StaticResource Muted}" Margin="0,12,0,16"/><Button x:Name="CheckIntegrity" Content="Verify release now" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PC and email alerts" Style="{StaticResource Heading}"/><CheckBox x:Name="EmailEnabled" Content="Enable email alerts on this installation"/><TextBlock Text="Recipient"/><TextBox x:Name="EmailRecipient"/><TextBlock Text="Sender email / SMTP username"/><TextBox x:Name="EmailSender"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="SMTP server"/><TextBox x:Name="EmailHost"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="STARTTLS port"/><TextBox x:Name="EmailPort"/></StackPanel></Grid><TextBlock Text="Sender app password (stored encrypted for this Windows user)"/><PasswordBox x:Name="EmailPassword"/><CheckBox x:Name="IncludeDevice"><TextBlock Text="I consent to sending this PC name and local IPv4 addresses to the recipient above" TextWrapping="Wrap"/></CheckBox><TextBlock Text="Device reporting is optional and off by default. No public-IP lookup or hidden tracking is used. The identifiers do not identify a person. Never distribute your sender credentials or signing key." Style="{StaticResource Muted}" Margin="0,10,0,12"/><WrapPanel><Button x:Name="SaveEmail" Content="Save email setup"/><Button x:Name="TestEmail" Content="Send test email"/></WrapPanel><TextBlock x:Name="EmailState" Text="Email is not configured. No email has been sent." Style="{StaticResource Muted}" Margin="0,14,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
   </Grid>
   <Border Grid.Row="2" BorderBrush="#1E2B38" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,15,0,0"><TextBlock x:Name="StatusText" Text="Waiting for your local session…" Foreground="#8198AA" TextTrimming="CharacterEllipsis"/></Border>
  </Grid>
 </Grid>
</Window>
